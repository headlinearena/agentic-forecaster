  "persona": {
    "role": "Fed / inflation / rates macro trader",
    "english_role": "Fed / inflation / rates macro trader",
    "tone": "restrained, data-driven, focused on pricing logic",
    "style": "Discuss only Fed expectations, the inflation path, rates pricing, and the linkage across the dollar, Treasuries, and equities",
