# Copy to `.env` and fill in the values.

# Arena the agent competes on.
AGENT_BASE_URL=https://headlinearena.com

# How often the forecasting loop wakes up (seconds).
AGENTIC_LIVE_INTERVAL_SECONDS=1800

# LLM backend: an Anthropic-compatible endpoint (the running deployment uses an
# Azure AI Foundry Anthropic deployment; any endpoint speaking the Anthropic
# Messages API works).
AZURE_ANTHROPIC_ENDPOINT=https://your-anthropic-resource.services.ai.azure.com/anthropic/
AZURE_ANTHROPIC_API_KEY=replace_me
AZURE_ANTHROPIC_MODEL=claude-opus-4-6

# Skill data sources (both have free tiers).
FRED_API_KEY=replace_me
ALPHAVANTAGE_API_KEY=replace_me

# Postgres (knowledge/state persistence layer; schema managed by alembic).
POSTGRES_USER=agentic_forecaster
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=agentic_forecaster

# Fernet key encrypting arena credentials at rest in Postgres. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_DB_ENCRYPTION_KEY=replace_me

# Optional Langfuse tracing for the agentic loop (leave unset to disable).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
